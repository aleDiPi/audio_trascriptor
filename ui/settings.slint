// Finestra Impostazioni: barra laterale a sinistra, Home all'apertura. Stile Fluent, DPI nativo.
import { Button, CheckBox, ComboBox, LineEdit, ProgressIndicator, ScrollView, Slider, TextEdit, Palette } from "std-widgets.slint";
// Texts of the interface: the global Tr is generated by build.rs from the [ui] section of lang/en.toml and filled at run time
import { Tr } from "tr.slint";
export { Tr }

component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <bool> active;
    callback clicked();
    height: 38px;
    border-radius: 6px;
    background: active ? Palette.accent-background.with-alpha(0.18) : ta.has-hover ? Palette.foreground.with-alpha(0.07) : transparent;
    Rectangle {
        x: 0px;
        y: 9px;
        width: 3px;
        height: 20px;
        border-radius: 2px;
        background: Palette.accent-background;
        visible: root.active;
    }
    HorizontalLayout {
        padding-left: 14px;
        spacing: 10px;
        Text {
            text: root.glyph;
            width: 20px;
            vertical-alignment: center;
            horizontal-alignment: center;
            font-size: 15px;
            color: root.active ? Palette.accent-background : Palette.foreground;
        }
        Text {
            text: root.label;
            vertical-alignment: center;
            font-size: 14px;
            font-weight: root.active ? 600 : 400;
            color: Palette.foreground;
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

component Card inherits Rectangle {
    in property <string> title;
    background: Palette.control-background;
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border;
    min-height: inner.min-height;
    preferred-height: inner.preferred-height;
    inner := VerticalLayout {
        padding: 14px;
        spacing: 6px;
        Text {
            text: root.title;
            font-size: 12px;
            color: Palette.foreground.with-alpha(0.65);
        }
        @children
    }
}

// Omaggio a Stack Overflow: tre barre impilate (un impilamento di risposte) e un ringraziamento. Non e' il logo ufficiale.
component PadTribute inherits Rectangle {
    border-radius: 6px;
    background: #f4802422;
    min-height: row.min-height + 20px;
    row := HorizontalLayout {
        padding: 10px;
        spacing: 12px;
        Rectangle {
            width: 28px;
            for i in 4: Rectangle {
                x: 2px + i * 1px;
                y: 20px - i * 6px;
                width: 22px - i * 2px;
                height: 4px;
                border-radius: 2px;
                background: i == 3 ? #bcbbbb : #f48024;
            }
        }
        VerticalLayout {
            spacing: 3px;
            Text { text: Tr.pad_tribute_title; font-size: 14px; font-weight: 600; color: Palette.foreground; }
            Text { text: Tr.pad_tribute_text; wrap: word-wrap; font-size: 12px; color: Palette.foreground.with-alpha(0.85); }
        }
    }
}

component PadRow inherits HorizontalLayout {
    in property <string> label;
    in property <[string]> choices;
    in property <int> index;
    in property <bool> active: true;
    callback selected(int);
    spacing: 12px;
    Text { text: root.label; width: 150px; vertical-alignment: center; color: Palette.foreground; font-size: 13px; }
    ComboBox {
        model: root.choices;
        current-index: root.index;
        enabled: root.active;
        selected(_) => { root.selected(self.current-index); }
    }
}

component Title inherits Text {
    font-size: 22px;
    font-weight: 600;
    color: Palette.foreground;
}

component Note inherits Text {
    wrap: word-wrap;
    font-size: 13px;
    color: Palette.foreground.with-alpha(0.75);
}

component Label inherits Text {
    font-size: 13px;
    font-weight: 600;
    color: Palette.foreground;
}

export struct Tile {
    id: string,
    name: string,
    enabled: bool,
    has-key: bool,
    ready: bool,
    status: string,
    key-note: string,
    stt-model: string,
    llm-model: string,
    models-editable: bool,
    supports-stt: bool,
    info: string,
    result: string,
    busy: bool,
    clear-seq: int,
    is-local: bool,
    local-index: int,
    downloading: bool,
    progress: float,
    local-detail: string,
}

component TileKeyRow inherits HorizontalLayout {
    in property <bool> has-key;
    in property <string> key-note;
    in property <bool> busy;
    in property <int> clear-seq;
    callback save(string);
    callback remove();
    callback link();
    spacing: 8px;
    field := LineEdit {
        input-type: password;
        placeholder-text: root.has-key ? root.key-note : Tr.paste_api_key;
        horizontal-stretch: 1;
    }
    changed clear-seq => { field.text = ""; }
    Button { text: Tr.verify_save; primary: true; enabled: !root.busy; clicked => { root.save(field.text); } }
    Button { text: Tr.remove; enabled: root.has-key && !root.busy; clicked => { root.remove(); } }
    Button { text: Tr.create_key; clicked => { root.link(); } }
}

component TileView inherits Rectangle {
    in property <Tile> t;
    in property <int> pos;
    in property <bool> dragging;
    in property <[string]> local-labels;
    callback set-local-size(int);
    callback download-local();
    callback cancel-download();
    callback delete-local();
    callback save-key(string);
    callback remove-key();
    callback open-keys();
    callback open-billing();
    callback save-models(string, string);
    callback toggle-use(bool);
    height: 250px;
    background: Palette.control-background;
    border-radius: 10px;
    border-width: dragging ? 2px : 1px;
    border-color: dragging ? Palette.accent-background : Palette.border;
    drop-shadow-blur: dragging ? 18px : 0px;
    drop-shadow-color: #00000055;
    opacity: t.enabled ? 1.0 : 0.72;

    VerticalLayout {
        padding: 14px;
        padding-left: 44px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 10px;
            height: 30px;
            Text {
                text: t.name;
                font-size: 17px;
                font-weight: 700;
                color: Palette.foreground;
                vertical-alignment: center;
            }
            Rectangle {
                width: 26px;
                height: 22px;
                border-radius: 11px;
                background: t.enabled ? Palette.accent-background.with-alpha(0.2) : Palette.foreground.with-alpha(0.1);
                Text { text: t.enabled ? "#" + (root.pos + 1) : "-"; font-size: 12px; color: Palette.foreground; }
            }
            Rectangle {
                height: 22px;
                border-radius: 11px;
                background: !t.has-key ? Palette.foreground.with-alpha(0.1) : t.ready ? #2e9e5b33 : #d9822b33;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text { text: t.status; font-size: 12px; vertical-alignment: center; color: Palette.foreground; }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            CheckBox { text: Tr.use; checked: t.enabled; toggled => { root.toggle-use(self.checked); } }
        }
        if !t.is-local: TileKeyRow {
            has-key: t.has-key;
            key-note: t.key-note;
            busy: t.busy;
            clear-seq: t.clear-seq;
            save(k) => { root.save-key(k); }
            remove => { root.remove-key(); }
            link => { root.open-keys(); }
        }
        if t.is-local: HorizontalLayout {
            spacing: 8px;
            ComboBox {
                model: root.local-labels;
                current-index: t.local-index;
                enabled: !t.downloading;
                horizontal-stretch: 1;
                selected(_) => { root.set-local-size(self.current-index); }
            }
            Button { text: Tr.download; primary: true; enabled: !t.has-key && !t.downloading; clicked => { root.download-local(); } }
            if t.downloading: Button { text: Tr.cancel; clicked => { root.cancel-download(); } }
            if !t.downloading: Button { text: Tr.delete; enabled: t.has-key; clicked => { root.delete-local(); } }
        }
        if t.is-local && t.downloading: ProgressIndicator {
            progress: max(t.progress, 0.0);
            indeterminate: t.progress < 0;
        }
        if t.is-local: Text { text: t.local-detail; font-size: 12px; color: Palette.foreground; wrap: word-wrap; }
        if t.models-editable: HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;
                visible: t.supports-stt;
                Text { text: Tr.transcription; font-size: 11px; color: Palette.foreground.with-alpha(0.65); }
                stt-edit := LineEdit { text: t.stt-model; enabled: t.supports-stt; }
            }
            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;
                Text { text: Tr.text_correction; font-size: 11px; color: Palette.foreground.with-alpha(0.65); }
                llm-edit := LineEdit { text: t.llm-model; }
            }
            VerticalLayout { alignment: end; Button { text: Tr.save_models; clicked => { root.save-models(stt-edit.text, llm-edit.text); } } }
        }
        if !t.models-editable && !t.is-local: HorizontalLayout {
            spacing: 24px;
            VerticalLayout {
                spacing: 2px;
                Text { text: Tr.transcription; font-size: 11px; color: Palette.foreground.with-alpha(0.65); }
                Text { text: t.stt-model; font-size: 13px; color: Palette.foreground; }
            }
            VerticalLayout {
                spacing: 2px;
                Text { text: Tr.text_correction_fallback; font-size: 11px; color: Palette.foreground.with-alpha(0.65); }
                Text { text: t.llm-model; font-size: 13px; color: Palette.foreground; }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Text { text: t.info; font-size: 12px; color: Palette.foreground.with-alpha(0.75); wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
            if !t.is-local: Button { text: Tr.credit_plan; clicked => { root.open-billing(); } }
        }
        Text { text: t.result; font-size: 12px; color: Palette.foreground; wrap: word-wrap; }
    }

    // maniglia grafica (l'area che cattura il trascinamento sta fuori dalla tessera, ferma)
    Text {
        x: 12px;
        y: 0px;
        width: 24px;
        height: parent.height;
        text: "⋮⋮";
        font-size: 22px;
        color: Palette.foreground.with-alpha(0.5);
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component SettingsWindow inherits Window {
    title: Tr.window_title;
    icon: @image-url("../assets/icon-256.png");
    preferred-width: 900px;
    preferred-height: 640px;
    min-width: 560px;
    min-height: 380px;
    background: Palette.background;

    in-out property <int> page: 0;

    // --- Home
    in property <string> home-order;
    in property <string> home-ai;
    in property <string> home-stt;
    in property <string> home-hotkey;
    in property <string> home-version;
    in property <string> home-updates;
    in property <string> home-keys;
    in property <string> home-usage;
    // --- AI (tessere)
    in-out property <[Tile]> tiles;
    in property <string> usage-text;
    in property <string> order-note;
    in property <[string]> local-size-labels;
    property <int> drag-idx: -1;
    property <length> drag-dy: 0px;
    property <length> slot: 262px;
    property <int> drag-target: max(0, min(tiles.length - 1, Math.round((drag-idx * slot + drag-dy) / slot)));
    // --- GitHub
    // --- Impostazioni
    in-out property <bool> auto-update;
    in-out property <bool> overlay;
    in-out property <bool> debug;
    in-out property <bool> debug-text;
    in-out property <bool> sounds;
    // tastiera Stack Overflow a 3 tasti: la scheda compare solo se e' collegata
    in property <bool> pad-present;
    in property <string> pad-name;
    in-out property <bool> pad-enabled;
    in property <int> pad-logo;
    in property <int> pad-c;
    in property <int> pad-v;
    in-out property <bool> echo-cancel;
    in property <bool> echo-available;
    in-out property <bool> autostart;
    // true su Linux: nessun bollino a schermo, testi senza riferimenti a Windows
    in property <bool> linux;
    in property <int> sound-style-index;
    // language of the interface: names (first one = automatic) and selected position
    in property <[string]> lang-names;
    in property <int> lang-index;
    in-out property <float> sound-volume;
    in property <string> upd-result;
    in property <bool> upd-busy;
    in property <string> log-line;
    // --- Prompt
    in property <[string]> prompt-titles;
    in property <string> prompt-text;
    // --- Info
    in property <string> ver-info;
    in property <string> general-info;
    in property <string> legal-disclaimer;
    in property <string> legal-license;

    callback save-key(string, string);
    callback remove-key(string);
    callback open-keys(string);
    callback open-billing(string);
    callback save-models(string, string, string);
    callback toggle-use(string, bool);
    callback set-local-size(int);
    callback download-local();
    callback cancel-download();
    callback delete-local();
    callback reorder(int, int);
    callback toggle-auto-update(bool);
    callback toggle-overlay(bool);
    callback toggle-debug(bool);
    callback toggle-debug-text(bool);
    callback check-update();
    callback apply-update();
    callback toggle-sounds(bool);
    callback toggle-pad(bool);
    callback set-pad-action(int, int);
    callback toggle-echo-cancel(bool);
    callback toggle-autostart(bool);
    callback set-sound-style(int);
    callback set-sound-volume(int);
    callback preview-sound();
    callback open-log();
    callback open-folder();
    callback select-prompt(int);
    callback set-language(int);
    // backup of the settings: dialog 0 = none, 1 = export, 2 = import
    in-out property <int> dialog;
    in-out property <string> backup-path;
    in-out property <string> backup-status;
    in property <bool> backup-ok;
    in property <bool> backup-busy;
    in-out property <bool> import-needs-password;
    in-out property <string> import-info;
    in-out property <string> import-pw;
    callback backup-browse(bool);
    callback export-settings(string, string, string, bool, bool, bool);
    callback inspect-import(string);
    callback import-settings(string, string);


    HorizontalLayout {
        // ---------- barra laterale
        Rectangle {
            width: 210px;
            background: Palette.alternate-background;
            VerticalLayout {
                padding: 12px;
                spacing: 4px;
                alignment: start;
                Text {
                    text: "Trascrittore";
                    font-size: 18px;
                    font-weight: 700;
                    color: Palette.foreground;
                    height: 44px;
                    vertical-alignment: center;
                    horizontal-alignment: left;
                }
                NavItem { label: Tr.nav_home; glyph: "⌂"; active: root.page == 0; clicked => { root.page = 0; } }
                NavItem { label: Tr.nav_ai; glyph: "✦"; active: root.page == 1; clicked => { root.page = 1; } }
                                NavItem { label: Tr.nav_prompt; glyph: "✎"; active: root.page == 2; clicked => { root.page = 2; } }
                NavItem { label: Tr.nav_settings; glyph: "⚙"; active: root.page == 3; clicked => { root.page = 3; } }
                NavItem { label: Tr.nav_info; glyph: "ⓘ"; active: root.page == 4; clicked => { root.page = 4; } }
            }
        }

        // ---------- contenuto
        ScrollView {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 28px;
                padding-top: 22px;
                spacing: 12px;
                alignment: start;

                // 0: Home
                if root.page == 0: VerticalLayout {
                    spacing: 12px;
                    Title { text: Tr.nav_home; }
                    Note { text: Tr.home_intro; }
                    HorizontalLayout {
                        spacing: 12px;
                        Card { title: Tr.card_ai; horizontal-stretch: 1;
                            Text { text: root.home-ai; font-size: 16px; font-weight: 600; color: Palette.foreground; wrap: word-wrap; }
                        }
                        Card { title: Tr.card_stt; horizontal-stretch: 1;
                            Text { text: root.home-stt; font-size: 16px; font-weight: 600; color: Palette.foreground; wrap: word-wrap; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Card { title: Tr.card_order; horizontal-stretch: 1;
                            Text { text: root.home-order; font-size: 14px; color: Palette.foreground; wrap: word-wrap; }
                            Text { text: root.home-keys; font-size: 12px; color: Palette.foreground.with-alpha(0.65); wrap: word-wrap; }
                        }
                        Card { title: Tr.card_hotkey; horizontal-stretch: 1;
                            Text { text: root.home-hotkey; font-size: 14px; color: Palette.foreground; wrap: word-wrap; }
                        }
                    }
                    Card { title: Tr.card_version;
                        Text { text: root.home-version; font-size: 14px; color: Palette.foreground; wrap: word-wrap; }
                        Text { text: root.home-updates; font-size: 12px; color: Palette.foreground.with-alpha(0.65); wrap: word-wrap; }
                    }
                    Card { title: Tr.card_usage;
                        Text { text: root.home-usage; font-size: 13px; color: Palette.foreground; wrap: word-wrap; }
                    }
                }

                // 1: AI (tessere)
                if root.page == 1: VerticalLayout {
                    spacing: 10px;
                    Title { text: Tr.nav_ai; }
                    Note { text: Tr.ai_note; }
                    Rectangle {
                        height: root.tiles.length * root.slot - 12px;
                        for tile[i] in root.tiles: TileView {
                            x: 0px;
                            width: parent.width;
                            t: tile;
                            pos: i;
                            local-labels: root.local-size-labels;
                            set-local-size(n) => { root.set-local-size(n); }
                            download-local => { root.download-local(); }
                            cancel-download => { root.cancel-download(); }
                            delete-local => { root.delete-local(); }
                            dragging: root.drag-idx == i;
                            y: root.drag-idx == i ? max(0px, min((root.tiles.length - 1) * root.slot, i * root.slot + root.drag-dy))
                                : root.drag-idx < 0 ? i * root.slot
                                : (root.drag-idx < i && i <= root.drag-target) ? (i - 1) * root.slot
                                : (root.drag-target <= i && i < root.drag-idx) ? (i + 1) * root.slot
                                : i * root.slot;
                            animate y { duration: root.drag-idx == i ? 0ms : 140ms; easing: ease-out; }
                            save-key(k) => { root.save-key(tile.id, k); }
                            remove-key => { root.remove-key(tile.id); }
                            open-keys => { root.open-keys(tile.id); }
                            open-billing => { root.open-billing(tile.id); }
                            save-models(a, b) => { root.save-models(tile.id, a, b); }
                            toggle-use(on) => { root.toggle-use(tile.id, on); }
                        }
                        for tile[i] in root.tiles: TouchArea {
                            x: 0px;
                            y: i * root.slot;
                            width: 40px;
                            height: 250px;
                            mouse-cursor: root.drag-idx == i ? MouseCursor.grabbing : MouseCursor.grab;
                            pointer-event(e) => {
                                if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                                    root.drag-dy = 0px;
                                    root.drag-idx = i;
                                } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                                    if root.drag-idx == i {
                                        if root.drag-target != i { root.reorder(i, root.drag-target); }
                                        root.drag-idx = -1;
                                        root.drag-dy = 0px;
                                    }
                                }
                            }
                            moved => {
                                if root.drag-idx == i { root.drag-dy = self.mouse-y - self.pressed-y; }
                            }
                        }
                    }
                    Note { text: root.order-note; }
                    Label { text: Tr.groq_usage; }
                    TextEdit { read-only: true; text: root.usage-text; min-height: 150px; }
                }

                // 2: Prompt
                if root.page == 2: VerticalLayout {
                    spacing: 10px;
                    Title { text: Tr.nav_prompt; }
                    Note { text: Tr.prompt_note; }
                    ComboBox {
                        model: root.prompt-titles;
                        selected(_) => { root.select-prompt(self.current-index); }
                    }
                    TextEdit { read-only: true; text: root.prompt-text; min-height: 360px; }
                }

                // 3: Impostazioni
                if root.page == 3: VerticalLayout {
                    spacing: 10px;
                    Title { text: Tr.nav_settings; }
                    if root.pad-present: Card { title: Tr.card_pad;
                        PadTribute { }
                        CheckBox { text: Tr.pad_check; checked: root.pad-enabled; toggled => { root.toggle-pad(self.checked); } }
                        Note { text: Tr.pad_connected + " " + root.pad-name; }
                        PadRow {
                            label: Tr.pad_btn_logo;
                            choices: [Tr.pad_full, Tr.pad_raw_send, Tr.pad_raw, Tr.pad_ai, Tr.pad_off];
                            index: root.pad-logo;
                            active: root.pad-enabled;
                            selected(i) => { root.set-pad-action(0, i); }
                        }
                        PadRow {
                            label: Tr.pad_btn_c;
                            choices: [Tr.pad_full, Tr.pad_raw_send, Tr.pad_raw, Tr.pad_ai, Tr.pad_off];
                            index: root.pad-c;
                            active: root.pad-enabled;
                            selected(i) => { root.set-pad-action(1, i); }
                        }
                        PadRow {
                            label: Tr.pad_btn_v;
                            choices: [Tr.pad_full, Tr.pad_raw_send, Tr.pad_raw, Tr.pad_ai, Tr.pad_off];
                            index: root.pad-v;
                            active: root.pad-enabled;
                            selected(i) => { root.set-pad-action(2, i); }
                        }
                        Note { text: Tr.pad_note; }
                        Note { text: Tr.pad_disclaimer; font-size: 11px; }
                    }
                    Card { title: Tr.card_startup;
                        CheckBox { text: root.linux ? Tr.autostart_linux : Tr.autostart_windows; checked: root.autostart; toggled => { root.toggle-autostart(self.checked); } }
                    }
                    if !root.linux: Card { title: Tr.card_dictation;
                        CheckBox { text: Tr.overlay_check; checked: root.overlay; toggled => { root.toggle-overlay(self.checked); } }
                    }
                    Card { title: Tr.card_echo;
                        CheckBox { text: Tr.echo_check; checked: root.echo-cancel; enabled: root.echo-available; toggled => { root.toggle-echo-cancel(self.checked); } }
                        Note { text: root.echo-available ? Tr.echo_note : Tr.echo_unavailable; }
                    }
                    Card { title: Tr.card_sounds;
                        CheckBox { text: Tr.sounds_check; checked: root.sounds; toggled => { root.toggle-sounds(self.checked); } }
                        HorizontalLayout {
                            spacing: 12px;
                            Text { text: Tr.sound_type; vertical-alignment: center; color: Palette.foreground; font-size: 13px; }
                            ComboBox {
                                model: [Tr.sound_soft, Tr.sound_click, Tr.sound_chime];
                                current-index: root.sound-style-index;
                                enabled: root.sounds;
                                selected(_) => { root.set-sound-style(self.current-index); }
                            }
                            Button { text: Tr.try_sound; clicked => { root.preview-sound(); } }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            Text { text: Tr.volume; vertical-alignment: center; color: Palette.foreground; font-size: 13px; }
                            vol := Slider {
                                minimum: 0;
                                maximum: 100;
                                value: root.sound-volume;
                                enabled: root.sounds;
                                released(v) => { root.set-sound-volume(Math.round(v)); }
                            }
                            Text { text: Math.round(vol.value) + "%"; width: 40px; vertical-alignment: center; color: Palette.foreground; font-size: 13px; }
                        }
                        Note { text: Tr.sounds_note; }
                    }
                    Card { title: Tr.card_language;
                        Note { text: Tr.language_note; }
                        ComboBox {
                            model: root.lang-names;
                            current-index: root.lang-index;
                            selected(_) => { root.set-language(self.current-index); }
                        }
                    }
                    Card { title: Tr.card_backup;
                        Note { text: Tr.backup_note; }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Button { text: Tr.backup_export; clicked => { root.backup-path = ""; root.backup-status = ""; root.dialog = 1; } }
                            Button { text: Tr.backup_import; clicked => { root.backup-path = ""; root.backup-status = ""; root.import-pw = ""; root.import-needs-password = false; root.import-info = ""; root.dialog = 2; } }
                        }
                        Note { text: root.backup-status; }
                    }
                    Card { title: Tr.card_config;
                        Note { text: Tr.config_note; }
                        HorizontalLayout {
                            alignment: start;
                            Button { text: Tr.open_config; clicked => { root.open-folder(); } }
                        }
                    }
                }

                // 4: Info (versione, aggiornamenti, log)
                if root.page == 4: VerticalLayout {
                    spacing: 10px;
                    Title { text: Tr.nav_info; }
                    Card { title: Tr.card_ver;
                        Text { text: root.ver-info; font-size: 13px; color: Palette.foreground; wrap: word-wrap; }
                    }
                    Card { title: Tr.card_updates;
                        CheckBox { text: Tr.auto_update_check; checked: root.auto-update; toggled => { root.toggle-auto-update(self.checked); } }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Button { text: Tr.check_updates; enabled: !root.upd-busy; clicked => { root.check-update(); } }
                            Button { text: Tr.update_now; enabled: !root.upd-busy; clicked => { root.apply-update(); } }
                        }
                        Note { text: root.upd-result; }
                    }
                    Card { title: Tr.card_log;
                        CheckBox { text: Tr.debug_check; checked: root.debug; toggled => { root.toggle-debug(self.checked); } }
                        CheckBox { text: Tr.debug_text_check; enabled: root.debug; checked: root.debug-text; toggled => { root.toggle-debug-text(self.checked); } }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Button { text: Tr.open_log; clicked => { root.open-log(); } }
                            Button { text: Tr.open_config; clicked => { root.open-folder(); } }
                        }
                        Note { text: root.log-line; }
                        Note { text: Tr.debug_off_note; }
                    }
                    Card { title: Tr.card_legal;
                        Label { text: Tr.legal_disclaimer; }
                        TextEdit { read-only: true; text: root.legal-disclaimer; min-height: 200px; }
                        Label { text: Tr.legal_license; }
                        TextEdit { read-only: true; text: root.legal-license; min-height: 200px; }
                    }
                    TextEdit { read-only: true; text: root.general-info; min-height: 220px; }
                    Note { text: Tr.slint_note; }
                }
            }
        }
    }

    // ---------- finestre di esportazione e importazione
    if root.dialog != 0: Rectangle {
        x: 0px; y: 0px;
        width: root.width;
        height: root.height;
        background: black.with-alpha(0.45);
        TouchArea { }
        Rectangle {
            width: min(520px, root.width - 40px);
            height: min(dlg.preferred-height + 40px, root.height - 40px);
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.foreground.with-alpha(0.25);
            dlg := VerticalLayout {
                padding: 20px;
                spacing: 10px;
                alignment: start;
                if root.dialog == 1: VerticalLayout {
                    spacing: 10px;
                    Title { text: Tr.backup_export_title; }
                    Label { text: Tr.backup_what; }
                    pf := CheckBox { text: Tr.backup_part_prefs; checked: true; }
                    pp := CheckBox { text: Tr.backup_part_prompts; checked: true; }
                    pk := CheckBox { text: Tr.backup_part_keys; checked: true; }
                    Label { text: Tr.backup_password; }
                    pw1 := LineEdit { input-type: password; placeholder-text: Tr.backup_password_hint; }
                    pw2 := LineEdit { input-type: password; placeholder-text: Tr.backup_password_again; enabled: pw1.text != ""; }
                    Label { text: Tr.backup_file; }
                    HorizontalLayout {
                        spacing: 8px;
                        LineEdit { text <=> root.backup-path; horizontal-stretch: 1; }
                        Button { text: Tr.backup_browse; clicked => { root.backup-browse(true); } }
                    }
                    Note { text: root.backup-status; color: root.backup-ok ? Palette.foreground : #d9534f; }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        Button { text: Tr.cancel; clicked => { root.dialog = 0; } }
                        Button {
                            text: Tr.backup_export;
                            primary: true;
                            enabled: !root.backup-busy && (pf.checked || pp.checked || pk.checked);
                            clicked => { root.export-settings(root.backup-path, pw1.text, pw2.text, pf.checked, pp.checked, pk.checked); }
                        }
                    }
                }
                if root.dialog == 2: VerticalLayout {
                    spacing: 10px;
                    Title { text: Tr.backup_import_title; }
                    Rectangle {
                        height: 64px;
                        border-width: 1px;
                        border-color: Palette.foreground.with-alpha(0.4);
                        border-radius: 6px;
                        Text {
                            text: Tr.backup_drop;
                            color: Palette.foreground.with-alpha(0.75);
                            font-size: 13px;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: parent.width - 16px;
                        }
                    }
                    Label { text: Tr.backup_file; }
                    HorizontalLayout {
                        spacing: 8px;
                        LineEdit {
                            text <=> root.backup-path;
                            horizontal-stretch: 1;
                            accepted(_) => { root.inspect-import(self.text); }
                        }
                        Button { text: Tr.backup_browse; clicked => { root.backup-browse(false); } }
                    }
                    Note { text: root.import-info; }
                    if root.import-needs-password: VerticalLayout {
                        spacing: 6px;
                        Label { text: Tr.backup_password_ask; }
                        LineEdit { input-type: password; text <=> root.import-pw; accepted(t) => { root.import-settings(root.backup-path, t); } }
                    }
                    Note { text: root.backup-status; color: root.backup-ok ? Palette.foreground : #d9534f; }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        Button { text: Tr.cancel; clicked => { root.dialog = 0; } }
                        Button {
                            text: Tr.backup_import;
                            primary: true;
                            enabled: !root.backup-busy && root.backup-path != "";
                            clicked => { root.import-settings(root.backup-path, root.import-needs-password ? root.import-pw : ""); }
                        }
                    }
                }
            }
        }
    }
}
