// Finestra Impostazioni: barra laterale a sinistra, Home all'apertura. Stile Fluent, DPI nativo.
import { Button, CheckBox, ComboBox, LineEdit, ScrollView, TextEdit, Palette } from "std-widgets.slint";

component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <bool> active;
    callback clicked();
    height: 38px;
    border-radius: 6px;
    background: active ? Palette.accent-background.with-alpha(0.18) : ta.has-hover ? Palette.foreground.with-alpha(0.07) : transparent;
    Rectangle {
        x: 0px;
        y: 9px;
        width: 3px;
        height: 20px;
        border-radius: 2px;
        background: Palette.accent-background;
        visible: root.active;
    }
    HorizontalLayout {
        padding-left: 14px;
        spacing: 10px;
        Text {
            text: root.glyph;
            width: 20px;
            vertical-alignment: center;
            horizontal-alignment: center;
            font-size: 15px;
            color: root.active ? Palette.accent-background : Palette.foreground;
        }
        Text {
            text: root.label;
            vertical-alignment: center;
            font-size: 14px;
            font-weight: root.active ? 600 : 400;
            color: Palette.foreground;
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

component Card inherits Rectangle {
    in property <string> title;
    background: Palette.control-background;
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border;
    min-height: inner.min-height;
    preferred-height: inner.preferred-height;
    inner := VerticalLayout {
        padding: 14px;
        spacing: 6px;
        Text {
            text: root.title;
            font-size: 12px;
            color: Palette.foreground.with-alpha(0.65);
        }
        @children
    }
}

component Title inherits Text {
    font-size: 22px;
    font-weight: 600;
    color: Palette.foreground;
}

component Note inherits Text {
    wrap: word-wrap;
    font-size: 13px;
    color: Palette.foreground.with-alpha(0.75);
}

component Label inherits Text {
    font-size: 13px;
    font-weight: 600;
    color: Palette.foreground;
}

component KeyRow inherits HorizontalLayout {
    in property <string> placeholder: "Incolla la chiave";
    in property <string> link-text;
    in property <bool> busy;
    out property <string> typed: field.text;
    callback save(string);
    callback link();
    callback clear-field();
    spacing: 8px;
    field := LineEdit {
        input-type: password;
        placeholder-text: root.placeholder;
        horizontal-stretch: 1;
    }
    Button {
        text: "Verifica e salva";
        primary: true;
        enabled: !root.busy;
        clicked => { root.save(field.text); }
    }
    Button {
        text: root.link-text;
        clicked => { root.link(); }
    }
    in property <int> clear-seq;
    changed clear-seq => { field.text = ""; }
}


export struct Tile {
    id: string,
    name: string,
    enabled: bool,
    has-key: bool,
    ready: bool,
    status: string,
    key-note: string,
    stt-model: string,
    llm-model: string,
    models-editable: bool,
    supports-stt: bool,
    info: string,
    result: string,
    busy: bool,
    clear-seq: int,
}

component TileView inherits Rectangle {
    in property <Tile> t;
    in property <int> pos;
    in property <bool> dragging;
    callback save-key(string);
    callback remove-key();
    callback open-keys();
    callback open-billing();
    callback save-models(string, string);
    callback toggle-use(bool);
    height: 232px;
    background: Palette.control-background;
    border-radius: 10px;
    border-width: dragging ? 2px : 1px;
    border-color: dragging ? Palette.accent-background : Palette.border;
    drop-shadow-blur: dragging ? 18px : 0px;
    drop-shadow-color: #00000055;
    opacity: t.enabled ? 1.0 : 0.72;

    property <int> seq: t.clear-seq;
    changed seq => { key-field.text = ""; }

    VerticalLayout {
        padding: 14px;
        padding-left: 44px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 10px;
            height: 30px;
            Text {
                text: t.name;
                font-size: 17px;
                font-weight: 700;
                color: Palette.foreground;
                vertical-alignment: center;
            }
            Rectangle {
                width: 26px;
                height: 22px;
                border-radius: 11px;
                background: t.enabled ? Palette.accent-background.with-alpha(0.2) : Palette.foreground.with-alpha(0.1);
                Text { text: t.enabled ? "#" + (root.pos + 1) : "-"; font-size: 12px; color: Palette.foreground; }
            }
            Rectangle {
                height: 22px;
                border-radius: 11px;
                background: !t.has-key ? Palette.foreground.with-alpha(0.1) : t.ready ? #2e9e5b33 : #d9822b33;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text { text: t.status; font-size: 12px; vertical-alignment: center; color: Palette.foreground; }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            CheckBox { text: "Usa"; checked: t.enabled; toggled => { root.toggle-use(self.checked); } }
        }
        HorizontalLayout {
            spacing: 8px;
            key-field := LineEdit {
                input-type: password;
                placeholder-text: t.has-key ? t.key-note : "Incolla la chiave API";
                horizontal-stretch: 1;
            }
            Button { text: "Verifica e salva"; primary: true; enabled: !t.busy; clicked => { root.save-key(key-field.text); } }
            Button { text: "Rimuovi"; enabled: t.has-key && !t.busy; clicked => { root.remove-key(); } }
            Button { text: "Crea chiave"; clicked => { root.open-keys(); } }
        }
        if t.models-editable: HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;
                visible: t.supports-stt;
                Text { text: "Trascrizione"; font-size: 11px; color: Palette.foreground.with-alpha(0.65); }
                stt-edit := LineEdit { text: t.stt-model; enabled: t.supports-stt; }
            }
            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;
                Text { text: "Correzione del testo"; font-size: 11px; color: Palette.foreground.with-alpha(0.65); }
                llm-edit := LineEdit { text: t.llm-model; }
            }
            VerticalLayout { alignment: end; Button { text: "Salva modelli"; clicked => { root.save-models(stt-edit.text, llm-edit.text); } } }
        }
        if !t.models-editable: HorizontalLayout {
            spacing: 24px;
            VerticalLayout {
                spacing: 2px;
                Text { text: "Trascrizione"; font-size: 11px; color: Palette.foreground.with-alpha(0.65); }
                Text { text: t.stt-model; font-size: 13px; color: Palette.foreground; }
            }
            VerticalLayout {
                spacing: 2px;
                Text { text: "Correzione del testo (con riserva)"; font-size: 11px; color: Palette.foreground.with-alpha(0.65); }
                Text { text: t.llm-model; font-size: 13px; color: Palette.foreground; }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Text { text: t.info; font-size: 12px; color: Palette.foreground.with-alpha(0.75); wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
            Button { text: "Credito e piano"; clicked => { root.open-billing(); } }
        }
        Text { text: t.result; font-size: 12px; color: Palette.foreground; wrap: word-wrap; }
    }

    // maniglia grafica (l'area che cattura il trascinamento sta fuori dalla tessera, ferma)
    Text {
        x: 12px;
        y: 0px;
        width: 24px;
        height: parent.height;
        text: "⋮⋮";
        font-size: 22px;
        color: Palette.foreground.with-alpha(0.5);
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component SettingsWindow inherits Window {
    title: "Trascrittore audio - Impostazioni";
    icon: @image-url("../assets/icon-256.png");
    preferred-width: 900px;
    preferred-height: 640px;
    min-width: 760px;
    min-height: 520px;
    background: Palette.background;

    in-out property <int> page: 0;

    // --- Home
    in property <string> home-order;
    in property <string> home-ai;
    in property <string> home-stt;
    in property <string> home-hotkey;
    in property <string> home-version;
    in property <string> home-updates;
    in property <string> home-keys;
    in property <string> home-usage;
    // --- AI (tessere)
    in-out property <[Tile]> tiles;
    in property <string> usage-text;
    in property <string> order-note;
    property <int> drag-idx: -1;
    property <length> drag-dy: 0px;
    property <length> slot: 244px;
    property <int> drag-target: max(0, min(tiles.length - 1, Math.round((drag-idx * slot + drag-dy) / slot)));
    // --- GitHub
    in property <string> token-status;
    in property <bool> token-busy;
    in property <int> token-clear-seq;
    // --- Impostazioni
    in-out property <bool> auto-update;
    in-out property <bool> overlay;
    in-out property <bool> debug;
    in-out property <bool> debug-text;
    in property <string> upd-result;
    in property <bool> upd-busy;
    in property <string> log-line;
    // --- Prompt
    in property <[string]> prompt-titles;
    in property <string> prompt-text;
    // --- Info
    in property <string> ver-info;
    in property <string> general-info;

    callback save-key(string, string);
    callback remove-key(string);
    callback open-keys(string);
    callback open-billing(string);
    callback save-models(string, string, string);
    callback toggle-use(string, bool);
    callback reorder(int, int);
    callback save-token(string);
    callback clear-token();
    callback open-github-link();
    callback toggle-auto-update(bool);
    callback toggle-overlay(bool);
    callback toggle-debug(bool);
    callback toggle-debug-text(bool);
    callback check-update();
    callback apply-update();
    callback open-log();
    callback open-folder();
    callback select-prompt(int);


    HorizontalLayout {
        // ---------- barra laterale
        Rectangle {
            width: 210px;
            background: Palette.alternate-background;
            VerticalLayout {
                padding: 12px;
                spacing: 4px;
                alignment: start;
                Text {
                    text: "Trascrittore";
                    font-size: 18px;
                    font-weight: 700;
                    color: Palette.foreground;
                    height: 44px;
                    vertical-alignment: center;
                    horizontal-alignment: left;
                }
                NavItem { label: "Home"; glyph: "⌂"; active: root.page == 0; clicked => { root.page = 0; } }
                NavItem { label: "AI"; glyph: "✦"; active: root.page == 1; clicked => { root.page = 1; } }
                                NavItem { label: "Prompt"; glyph: "✎"; active: root.page == 2; clicked => { root.page = 2; } }
                NavItem { label: "Impostazioni"; glyph: "⚙"; active: root.page == 3; clicked => { root.page = 3; } }
                NavItem { label: "Info"; glyph: "ⓘ"; active: root.page == 4; clicked => { root.page = 4; } }
            }
        }

        // ---------- contenuto
        ScrollView {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 28px;
                padding-top: 22px;
                spacing: 12px;
                alignment: start;

                // 0: Home
                if root.page == 0: VerticalLayout {
                    spacing: 12px;
                    Title { text: "Home"; }
                    Note { text: "Tieni premuta la scorciatoia, parla, rilascia: il testo corretto viene incollato dove hai il cursore."; }
                    HorizontalLayout {
                        spacing: 12px;
                        Card { title: "AI per la correzione del testo"; horizontal-stretch: 1;
                            Text { text: root.home-ai; font-size: 16px; font-weight: 600; color: Palette.foreground; wrap: word-wrap; }
                        }
                        Card { title: "Modello di trascrizione"; horizontal-stretch: 1;
                            Text { text: root.home-stt; font-size: 16px; font-weight: 600; color: Palette.foreground; wrap: word-wrap; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Card { title: "Servizi in ordine di priorita'"; horizontal-stretch: 1;
                            Text { text: root.home-order; font-size: 14px; color: Palette.foreground; wrap: word-wrap; }
                            Text { text: root.home-keys; font-size: 12px; color: Palette.foreground.with-alpha(0.65); wrap: word-wrap; }
                        }
                        Card { title: "Scorciatoia"; horizontal-stretch: 1;
                            Text { text: root.home-hotkey; font-size: 14px; color: Palette.foreground; wrap: word-wrap; }
                        }
                    }
                    Card { title: "Versione e aggiornamenti";
                        Text { text: root.home-version; font-size: 14px; color: Palette.foreground; wrap: word-wrap; }
                        Text { text: root.home-updates; font-size: 12px; color: Palette.foreground.with-alpha(0.65); wrap: word-wrap; }
                    }
                    Card { title: "Utilizzo";
                        Text { text: root.home-usage; font-size: 13px; color: Palette.foreground; wrap: word-wrap; }
                    }
                }

                // 1: AI (tessere)
                if root.page == 1: VerticalLayout {
                    spacing: 10px;
                    Title { text: "AI"; }
                    Note { text: "Trascina le tessere per cambiare la priorita': si parte dalla prima e, se un servizio finisce i crediti o rifiuta la chiave, si passa alla successiva (e si riprova dopo un'ora). Le chiavi sono salvate solo in .env."; }
                    Rectangle {
                        height: root.tiles.length * root.slot - 12px;
                        for tile[i] in root.tiles: TileView {
                            x: 0px;
                            width: parent.width;
                            t: tile;
                            pos: i;
                            dragging: root.drag-idx == i;
                            y: root.drag-idx == i ? max(0px, min((root.tiles.length - 1) * root.slot, i * root.slot + root.drag-dy))
                                : root.drag-idx < 0 ? i * root.slot
                                : (root.drag-idx < i && i <= root.drag-target) ? (i - 1) * root.slot
                                : (root.drag-target <= i && i < root.drag-idx) ? (i + 1) * root.slot
                                : i * root.slot;
                            animate y { duration: root.drag-idx == i ? 0ms : 140ms; easing: ease-out; }
                            save-key(k) => { root.save-key(tile.id, k); }
                            remove-key => { root.remove-key(tile.id); }
                            open-keys => { root.open-keys(tile.id); }
                            open-billing => { root.open-billing(tile.id); }
                            save-models(a, b) => { root.save-models(tile.id, a, b); }
                            toggle-use(on) => { root.toggle-use(tile.id, on); }
                        }
                        for tile[i] in root.tiles: TouchArea {
                            x: 0px;
                            y: i * root.slot;
                            width: 40px;
                            height: 232px;
                            mouse-cursor: root.drag-idx == i ? MouseCursor.grabbing : MouseCursor.grab;
                            pointer-event(e) => {
                                if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                                    root.drag-dy = 0px;
                                    root.drag-idx = i;
                                } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                                    if root.drag-idx == i {
                                        if root.drag-target != i { root.reorder(i, root.drag-target); }
                                        root.drag-idx = -1;
                                        root.drag-dy = 0px;
                                    }
                                }
                            }
                            moved => {
                                if root.drag-idx == i { root.drag-dy = self.mouse-y - self.pressed-y; }
                            }
                        }
                    }
                    Note { text: root.order-note; }
                    Label { text: "Utilizzo Groq (si aggiorna da solo)"; }
                    TextEdit { read-only: true; text: root.usage-text; min-height: 150px; }
                }

                // 2: Prompt
                if root.page == 2: VerticalLayout {
                    spacing: 10px;
                    Title { text: "Prompt"; }
                    Note { text: "Prompt inviati all'AI, per tipo di applicazione."; }
                    ComboBox {
                        model: root.prompt-titles;
                        selected(_) => { root.select-prompt(self.current-index); }
                    }
                    TextEdit { read-only: true; text: root.prompt-text; min-height: 360px; }
                }

                // 3: Impostazioni
                if root.page == 3: VerticalLayout {
                    spacing: 10px;
                    Title { text: "Impostazioni"; }
                    Card { title: "Durante la dettatura";
                        CheckBox { text: "Mostra l'icona con l'alone sonoro in basso a destra"; checked: root.overlay; toggled => { root.toggle-overlay(self.checked); } }
                    }
                    Card { title: "Configurazione";
                        Note { text: "Scorciatoia, lingua, modelli di Groq e prompt si cambiano in config.toml, poi \"Ricarica configurazione\" dal menu dell'icona."; }
                        HorizontalLayout {
                            alignment: start;
                            Button { text: "Apri cartella config"; clicked => { root.open-folder(); } }
                        }
                    }
                }

                // 4: Info (versione, aggiornamenti, log)
                if root.page == 4: VerticalLayout {
                    spacing: 10px;
                    Title { text: "Info"; }
                    Card { title: "Versione";
                        Text { text: root.ver-info; font-size: 13px; color: Palette.foreground; wrap: word-wrap; }
                    }
                    Card { title: "Aggiornamenti";
                        CheckBox { text: "Aggiornamenti automatici attivi (serve il token GitHub)"; checked: root.auto-update; toggled => { root.toggle-auto-update(self.checked); } }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Button { text: "Verifica aggiornamenti"; enabled: !root.upd-busy; clicked => { root.check-update(); } }
                            Button { text: "Aggiorna ora"; enabled: !root.upd-busy; clicked => { root.apply-update(); } }
                        }
                        Note { text: root.upd-result; }
                        Label { text: "Token GitHub (incolla qui per inserirlo o cambiarlo)"; }
                        token-row := KeyRow {
                            placeholder: "github_pat_...";
                            link-text: "Crea token";
                            busy: root.token-busy;
                            clear-seq: root.token-clear-seq;
                            save(k) => { root.save-token(k); }
                            link => { root.open-github-link(); }
                        }
                        HorizontalLayout {
                            alignment: start;
                            Button { text: "Rimuovi token"; clicked => { root.clear-token(); } }
                        }
                        Note { text: root.token-status; }
                        Note { text: "Come crearlo: \"Crea token\" apre la pagina. Scegli Resource owner aleDiPi, Repository access solo audio_trascriptor e Permissions > Contents = Read-only. Copia il token (inizia con github_pat_) e incollalo qui."; }
                    }
                    Card { title: "Log e diagnostica";
                        CheckBox { text: "Modalita' debug: scrive nel log ogni passaggio (mai chiavi o token)"; checked: root.debug; toggled => { root.toggle-debug(self.checked); } }
                        CheckBox { text: "Nel log anche testo dettato, prompt e risposta dell'AI (privato)"; enabled: root.debug; checked: root.debug-text; toggled => { root.toggle-debug-text(self.checked); } }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Button { text: "Apri log"; clicked => { root.open-log(); } }
                            Button { text: "Apri cartella config"; clicked => { root.open-folder(); } }
                        }
                        Note { text: root.log-line; }
                        Note { text: "Spegnendo il debug i file di log vengono cancellati."; }
                    }
                    TextEdit { read-only: true; text: root.general-info; min-height: 220px; }
                    Note { text: "Interfaccia realizzata con Slint (licenza royalty-free per applicazioni desktop, https://slint.dev)."; }
                }
            }
        }
    }
}
