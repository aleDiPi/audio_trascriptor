# FILE DI SICUREZZA - copia questo file in ".env" e inserisci la tua chiave.
# ".env" e' ignorato da git: NON caricarlo mai su GitHub.
# Chiave gratuita su https://console.groq.com/keys
GROQ_API_KEY=

# Facoltativi: servizi di riserva se Groq finisce i crediti (ordine in config.toml: providers).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Facoltativo: token GitHub "fine-grained" di SOLA LETTURA (Contents) su aleDiPi/audio_trascriptor.
# Se presente il programma si aggiorna da solo; se vuoto gli aggiornamenti sono manuali. Vedi README.
TRASCRITTORE_UPDATE_TOKEN=
